NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave da API da Anthropic (server-only — NUNCA use o prefixo NEXT_PUBLIC_
# aqui, senão ela vai parar no bundle JS exposto no navegador).
# Pegue em https://console.anthropic.com/settings/keys
# Usada só pelo /corretor (ferramenta interna de teste do motor de correção).
ANTHROPIC_API_KEY=

# Controla onde lib/corretor/feedback-real/ grava/lê os dados: em branco (ou
# qualquer valor diferente de "supabase") usa JSON local em
# lib/corretor/feedback-real/registros/ (modo dev). Defina como "supabase"
# em produção pra usar as tabelas correcoes/feedbacks_reais no Supabase.
FEEDBACK_REAL_STORE=

# Service role key do Supabase (server-only — NUNCA use o prefixo
# NEXT_PUBLIC_ aqui). Pegue em Project Settings > API no painel do
# Supabase. Só é necessária quando FEEDBACK_REAL_STORE=supabase — ignora
# RLS, então nunca deve ser exposta ao navegador nem usada fora de
# lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=
